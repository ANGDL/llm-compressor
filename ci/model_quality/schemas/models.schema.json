{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM Compressor model quality CI manifest",
  "type": "object",
  "required": ["schema_version", "models"],
  "properties": {
    "schema_version": {"const": 1},
    "includes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "resources", "workflow"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "enabled": {"type": "boolean"},
          "priority": {"enum": ["P0", "P1", "P2", "P3"]},
          "source": {
            "type": "object",
            "required": ["path"],
            "properties": {"path": {"type": "string", "minLength": 1}}
          },
          "resources": {
            "type": "object",
            "required": ["gpu_count", "estimated_gpu_hours"],
            "properties": {
              "gpu_count": {"type": "integer", "minimum": 1},
              "runtime_gpu_count": {"type": "integer", "minimum": 1},
              "evaluation_gpu_count": {"type": "integer", "minimum": 1},
              "estimated_gpu_hours": {"type": "number", "exclusiveMinimum": 0},
              "estimated_eval_gpu_hours": {"type": "number", "exclusiveMinimum": 0}
            }
          },
          "workflow": {
            "type": "object",
            "required": ["revision", "quantize"],
            "properties": {
              "revision": {"type": "string", "minLength": 1},
              "quantize": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            }
          },
          "validation": {
            "type": "object",
            "properties": {
              "profile": {"type": "string", "minLength": 1},
              "require_quantization_config": {"type": "boolean"},
              "streaming": {"type": "boolean"},
              "min_quantization_auxiliary_tensors": {
                "type": "integer",
                "minimum": 0
              },
              "required_files": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            }
          },
          "runtime_smoke": {
            "type": "object",
            "properties": {
              "enabled": {"type": "boolean"},
              "python": {"type": "string", "minLength": 1},
              "runtime_revision": {"type": "string", "minLength": 1},
              "prompts": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            }
          },
          "evaluation": {
            "type": "object",
            "properties": {
              "enabled_by_default": {"type": "boolean"},
              "profile": {"type": "string", "minLength": 1},
              "runtime_revision": {"type": "string", "minLength": 1},
              "command": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "result_file": {"type": "string", "minLength": 1}
            }
          },
          "upload": {
            "type": "object",
            "properties": {
              "enabled": {"type": "boolean"},
              "remote_prefix": {"type": "string", "minLength": 1},
              "allowlist": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "commands": {"$ref": "#/$defs/commands"},
              "verify_commands": {"$ref": "#/$defs/commands"},
              "success_commands": {"$ref": "#/$defs/commands"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "commands": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "minLength": 1}
      }
    }
  }
}
