# Copy this file to .model-quality/web-remote.env and edit the values.
# The copied file is ignored by git.

MQ_SSH_HOST=node16
# Optional: reuse an existing authenticated master (for example a Codex-owned
# socket). If it disappears, the manager falls back to its own socket.
MQ_EXISTING_CONTROL_SOCKET=
MQ_CONTAINER=llm-quant-base
MQ_REPO=/data/quant/llm-compressor

# Local browser port and container-internal service port may differ.
MQ_LOCAL_PORT=18080
MQ_REMOTE_PORT=18080
MQ_REMOTE_BIND=127.0.0.1

MQ_RUNS_ROOT=/ssd2/model-quality/runs
MQ_CONFIG=ci/model_quality/config/models.yaml
MQ_GIT_SHA=local
MQ_EXECUTOR=queue
MQ_GPU_HOUR_CAPACITY=80

# Optional worker process. Enable it when the Web queue should execute jobs
# immediately inside the quant container. Docker access is only needed for the
# inference job; lm-eval itself runs from a separate Conda env in this container.
MQ_WORKER_ENABLED=0
MQ_WORKER_POLL_SECONDS=2
MQ_CONTAINER_RUNTIME=docker
# Comma-separated reviewed inference containers and colon-separated absolute
# script roots inside those containers. Plan preview rejects other values.
MQ_INFERENCE_CONTAINERS=
MQ_INFERENCE_SCRIPT_ROOTS=/workspace
MQ_EVALUATION_COMMANDS=/root/miniconda/envs/model_quality_lm_eval/bin/python:/root/miniconda/envs/model_quality_evalscope/bin/python

# Python must exist inside MQ_CONTAINER. The manager auto-discovers common
# locations when this value is empty.
MQ_PYTHON=

# Runtime files and logs live outside the checkout by default.
MQ_RUNTIME_DIR=/tmp/model-quality-web
